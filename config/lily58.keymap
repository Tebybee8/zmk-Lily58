#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500 // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#define MO_TOG(layer) &mo_tog layer layer


// defining tapdance behaviors for toggle layers. Goal is: tap = nothing, hold = momentary layer 2, double tap = toggle layer 2.
/ { 
   
    behaviors {
/*

        layer2_tapdance: tap_dance_layer2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
	          //taps = <&none> , <&tog 2>; // Single tap = no operation, Double tap = toggle layer 2
						flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;     // should line up for tap = T, Hold = LCTRL, & Tap + hold for LSHIFT
        };
*/
        mo_tog: behavior_hold_tap {    
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";            // This flavor allows for preference given to the momentary layer.
            tapping-term-ms = <200>;              // 200 ms time window to register as a 'double tap'
            quick-tap-ms = <200>;
            bindings = <&mo>, <&tog>;             // this will allow single tap to toggle the layer in question with a hold being the traditional momentary layer
        };

            // Still trying this code: for this test: single tap should be the number 6, hold for LCTRL, and Tap + CTRL for LSHIFT
            // this behavior needs to be called out as follows: "layer2_hold_or_toggle 'holding operation' 0" as it requires 2 entries but doesn't use '0' here.
            // tap and tap and hold are modified directly within the behavior itself.

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

//putting toggle on for the raise and lowers for the time being - need more time with hold for momentary, tap or double dap for toggle.
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | CTRL  |  Z  |  X  |  C   |  V   |  B   |   DEL  |  | ENTER |  N   |  M    |  ,    |  .   |   /   |   ]   |
//                     | GUI  | ALT  | LOWER|  SPACE |  | BSPC  | RAISE| pgup  | pgdwn |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                      &kp N6 &kp N7     &kp N8    &kp N9  &kp N0   &kp GRAVE
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                       &kp Y  &kp U      &kp I     &kp O   &kp P    &kp LBKT
&kp LSHFT &kp A  &kp S  &kp D    &kp F    &kp G                       &kp H  &kp J      &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL &kp Z  &kp X  &kp C    &kp V    &kp B  &kp DEL    &kp RET   &kp N  &kp M      &kp COMMA &kp DOT &kp FSLH &kp RBKT
                        &kp LGUI &kp LALT MO_TOG(1)  &kp SPACE  &kp BSPC  MO_TOG(2)  &kp PG_UP &kp PG_DN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "Lower Layer";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |  "|"  |   /   |   *   |   -   |   =   |
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |      |   7   |   8   |   9   |   +   |       |
// | SHIFT |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   4   |   5   |   6   |       |       |
// | CTRL  |  F8 |  F9 |  F7  |  F11 |  F12 |        |  |       |      |   1   |   2   |   3   |       | enter |
//                     |      |      |      |  space |  |  bpsc |      |   0   |   .   |
            bindings = <
&bt BT_CLR &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2    &bt BT_SEL 3 &bt BT_SEL 4             &trans    &kp PIPE  &kp FSLH  &kp STAR    &kp MINUS    &kp EQUAL
&kp GRAVE &kp N1 &kp N2 &kp N3  &kp N4  &kp N5                                                 &trans    &kp N7    &kp N8    &kp N9      &kp PLUS     &trans
&kp LSHFT &kp F2 &kp F3 &kp F4  &kp F5  &kp F6                                                 &trans    &kp N4    &kp N5    &kp N6      &trans       &trans
&kp LCTRL &kp F8 &kp F9 &kp F7  &kp F11 &kp F12        &trans      &trans                      &trans    &kp N1    &kp N2    &kp N3      &trans       &kp RET
                  &trans     &trans     &trans         &kp SPACE   &kp BSPC                    &trans    &kp N0    &kp DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "Raise Layer";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   | v_dwn| v_up |  prev | play | next  |       |
// |       | sc_u| mr_c|  mup | ml_c | sc_d |                   |      |       |   ^   |      |       |       |
// | SHIFT | sc_l|mleft| mdwn |mright| sc_r |                   |      |   <-  |   v   |  ->  |       |       |
// | CTRL  |  F8 | F2  |  F7  |  F4  |  F3  |  HOME  |  |  END  |      |       |       |      |       |       |
//                     |      | mm_c |      |  space |  |  bpsc |      |       |       |
            bindings = <
&trans        &trans            &trans            &trans            &trans             &trans                                 &kp C_VOL_DN    &kp C_VOL_UP    &kp C_PREV     &kp C_PP        &kp C_NEXT     &trans
&trans        &msc SCRL_UP      &mkp MB2          &mmv MOVE_UP      &mkp MB1           &msc SCRL_DOWN                         &trans      &trans       &kp UP     &trans      &trans     &trans
&kp LSHFT     &msc SCRL_LEFT    &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_RIGHT    &msc SCRL_RIGHT                        &trans      &kp LEFT     &kp DOWN   &kp RIGHT   &trans     &trans
&kp LCTRL     &kp F8            &kp F2            &kp F7            &kp F4             &kp F3      &kp HOME     &kp END       &trans      &trans       &trans     &trans      &trans     &trans
                                                  &trans            &mkp MB3           &trans      &kp SPACE    &kp BSPC      &trans      &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
